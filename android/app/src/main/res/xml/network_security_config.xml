<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Yamaha Network Control is HTTP on the LAN (configurable receiver IP). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
